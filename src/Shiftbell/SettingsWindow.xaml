<Window x:Class="Shiftbell.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shiftbell"
        ThemeMode="System"
        Width="760" Height="640"
        MinWidth="640" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- The app's amber for accent buttons and checked toggles, whatever accent colour Windows uses (grey on some PCs). -->
    <Color x:Key="SystemAccentColor">#F5A623</Color>
    <Color x:Key="SystemAccentColorLight1">#F7B54A</Color>
    <Color x:Key="SystemAccentColorLight2">#F9C670</Color>
    <Color x:Key="SystemAccentColorLight3">#FBD796</Color>
    <Color x:Key="SystemAccentColorDark1">#D9902A</Color>
    <Color x:Key="SystemAccentColorDark2">#B87A23</Color>
    <Color x:Key="SystemAccentColorDark3">#96631C</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F5A623" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E9A033" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D9952F" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#F5A623" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E9A033" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D9952F" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#F5A623" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#E9A033" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#D9952F" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#3A3A3A" />
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="PageSub" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="Group" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,18,0,8" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- WPF has no toggle switch; this is the Windows 11 one, so turning an alarm off looks like it does in Settings. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Background="Transparent">
              <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#F5A623" />
                <Setter TargetName="Track" Property="BorderBrush" Value="#F5A623" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Fill" Value="#1A1A1A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Left navigation: a radio group drawn as Windows 11 nav items, with the accent pill on the selected one. -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Back" CornerRadius="6" Background="Transparent" Padding="12,9" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="20" Margin="0,1,12,0" VerticalAlignment="Center" />
                  <ContentPresenter VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Background="#F5A623" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="188" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Margin="10,14,8,0">
      <RadioButton x:Name="NavAlarms" Style="{StaticResource Nav}" Content="Alarms" Tag="&#xE916;" IsChecked="True" Checked="OnNav" />
      <RadioButton x:Name="NavGeneral" Style="{StaticResource Nav}" Content="General" Tag="&#xE713;" Checked="OnNav" />
      <RadioButton x:Name="NavDevices" Style="{StaticResource Nav}" Content="Devices" Tag="&#xE8AB;" Checked="OnNav" />
    </StackPanel>

    <!-- ===== Alarms ===== -->
    <ScrollViewer x:Name="AlarmsPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
      <StackPanel Margin="12,18,28,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="Alarms" />
        <TextBlock Style="{StaticResource PageSub}" Text="Click an alarm to change it. Alarms you add here also ring on your linked phone." />

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Next" Style="{StaticResource Hint}" />
              <TextBlock x:Name="NextTime" FontSize="28" FontWeight="SemiBold" Text="–" />
            </StackPanel>
            <TextBlock x:Name="NextDetail" Grid.Column="1" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" Margin="22,14,0,0" />
          </Grid>
        </Border>

        <StackPanel x:Name="AlarmList" />

        <Button x:Name="AddButton" Click="OnAdd" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,6">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,2,8,0" />
            <TextBlock Text="Add alarm" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== General ===== -->
    <ScrollViewer x:Name="GeneralPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="12,18,28,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="General" />
        <TextBlock Style="{StaticResource PageSub}" Text="Applies to every alarm on this PC. Changes are saved as you make them." />

        <TextBlock Style="{StaticResource Group}" Text="While it rings" />
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="SnoozeMinutes" Width="64" LostFocus="OnGeneralChanged" />
              <TextBlock Text="min" Margin="8,0,16,0" VerticalAlignment="Center" Opacity="0.7" />
              <TextBox x:Name="MaxSnoozes" Width="56" LostFocus="OnGeneralChanged" />
              <TextBlock Text="times" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Snooze" />
              <TextBlock Style="{StaticResource Hint}" Text="How long, and how many per alarm" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="CatchUpHours" Width="56" LostFocus="OnGeneralChanged" />
              <TextBlock Text="hours" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Missed alarms" />
              <TextBlock Style="{StaticResource Hint}" Text="Still ring this long after their time, if the PC was asleep or off" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="MinimumVolume" Width="56" LostFocus="OnGeneralChanged" />
              <TextBlock Text="%" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Lowest speaker volume" />
              <TextBlock Style="{StaticResource Hint}" Text="Raised to this only if lower, and put back after. 0 leaves the volume alone." />
            </StackPanel>
          </DockPanel>
        </Border>
        <TextBlock x:Name="GeneralError" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

        <TextBlock Style="{StaticResource Group}" Text="Startup" />
        <Border x:Name="StatusBorder" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock x:Name="StatusIcon" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Devices ===== -->
    <ScrollViewer x:Name="DevicesPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="12,18,28,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="Devices" />
        <TextBlock Style="{StaticResource PageSub}" Text="Linked devices share their alarms. Confirming, snoozing or a day off on one applies to all of them." />

        <Border Style="{StaticResource Card}">
          <TextBlock x:Name="SyncStatusText" TextWrapping="Wrap" />
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="PairButton" Content="Pair a phone" Click="OnPair" Style="{StaticResource AccentButtonStyle}" />
          <Button x:Name="UnpairButton" Content="Unpair" Click="OnUnpair" Margin="8,0,0,0" />
        </StackPanel>
        <Border x:Name="PairPanel" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,14,0,0" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- White behind the code whatever the theme: scanners read dark-on-light. -->
            <Border Background="White" Padding="8" CornerRadius="6" VerticalAlignment="Top">
              <Image x:Name="PairQr" Width="168" Height="168" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
              <TextBlock TextWrapping="Wrap" Text="On your phone, open Shiftbell, go to Settings, tap Link with PC and scan this. Or type the code below." />
              <TextBox x:Name="PairCode" IsReadOnly="True" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
              <Button Content="Copy code" Click="OnCopyCode" HorizontalAlignment="Left" Margin="0,8,0,0" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Anyone with this code can see when you time in and out, so only use it on your own devices." />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
