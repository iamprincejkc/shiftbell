<Window x:Class="Shiftbell.AlarmWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shiftbell alarm"
        ThemeMode="Dark"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#0D1015"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="#F3F4F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#F5A623" />
    <SolidColorBrush x:Key="AccentInk" Color="#1A1306" />
    <SolidColorBrush x:Key="Muted" Color="#9AA3AF" />
    <SolidColorBrush x:Key="Hairline" Color="#262B33" />

    <Style x:Key="BigButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="26,0" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#F3F4F6" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#262B33" />
                <Setter Property="Foreground" Value="#6B7280" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
      <Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="Background" Value="#1B2028" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="10,6">
              <ContentPresenter x:Name="Text" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#F3F4F6" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#4B5563" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Storyboard x:Key="Pulse" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.55" Duration="0:0:1.6" />
      <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.55" Duration="0:0:1.6" />
      <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.6" />
    </Storyboard>
  </Window.Resources>

  <Grid>
    <!-- Full screen: the whole monitor, nothing else visible. -->
    <Grid x:Name="FullLayout">
      <Grid.Background>
        <RadialGradientBrush x:Name="Glow" Center="0.5,0.32" GradientOrigin="0.5,0.32" RadiusX="0.7" RadiusY="0.75">
          <GradientStop x:Name="GlowStop" Color="#2A2110" Offset="0" />
          <GradientStop Color="#0D1015" Offset="1" />
        </RadialGradientBrush>
      </Grid.Background>

      <Border x:Name="Dither" IsHitTestVisible="False" />

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="980" Margin="32">

        <Grid Width="112" Height="112" HorizontalAlignment="Center" Margin="0,0,0,28">
          <Ellipse x:Name="PulseRing" Stroke="{DynamicResource Accent}" StrokeThickness="3" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <ScaleTransform />
            </Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Fill="{DynamicResource Accent}" />
          <TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="50" Foreground="{DynamicResource AccentInk}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
        </Grid>

        <Border HorizontalAlignment="Center" CornerRadius="13" Padding="14,5" Background="{DynamicResource Accent}" Margin="0,0,0,18">
          <TextBlock x:Name="KindTag" Text="TIME IN" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" />
        </Border>

        <TextBlock x:Name="Headline" Text="Time in now" FontSize="64" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" LineHeight="72" />

        <TextBlock x:Name="Detail" FontSize="22" Foreground="#C9CED6" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="32"
                   Text="Log in to your attendance system before 8:00 AM." />

        <TextBlock x:Name="Clock" FontSize="18" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,0"
                   Text="7:45 AM · 15 min left" />

        <!-- Only on the main monitor. Others show the message and point here. -->
        <StackPanel x:Name="Controls" Margin="0,40,0,0">

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="OpenAttendanceButton" Style="{StaticResource BigButton}" Click="OnOpenAttendance" Margin="6,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="OpenLabel" Text="Open attendance" />
                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="10,2,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="StepAsideButton" Style="{StaticResource GhostButton}" Click="OnStepAside" Margin="6,0"
                    ToolTip="Shrinks this to a small bar so you can do it. It comes back in 3 minutes if you have not confirmed.">
              <TextBlock x:Name="StepAsideLabel" Text="Let me do it now" />
            </Button>
          </StackPanel>

          <Border x:Name="ConfirmCard" Width="600" Background="#141820" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,28,0,0">
            <StackPanel>
              <TextBlock x:Name="ConfirmPrompt" FontSize="16" Foreground="#C9CED6" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Run x:Name="AskRun" Text="Timed in? Type " /><Run x:Name="PhraseRun" Text="done" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" /><Run Text=" to turn this off." />
              </TextBlock>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ConfirmBox" FontSize="18" Height="52" VerticalContentAlignment="Center" Padding="14,0"
                         TextChanged="OnConfirmTextChanged" KeyDown="OnConfirmKeyDown" AutomationProperties.Name="Confirmation phrase" />
                <Button x:Name="ConfirmButton" Grid.Column="1" Style="{StaticResource BigButton}" Margin="12,0,0,0" Click="OnConfirm" IsEnabled="False">
                  <TextBlock x:Name="ConfirmLabel" Text="I’ve timed in" />
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <Button x:Name="SnoozeButton" Style="{StaticResource LinkButton}" Click="OnSnooze" Margin="0,18,0,0" HorizontalAlignment="Center">
            <TextBlock x:Name="SnoozeLabel" Text="Snooze 5 min · 2 left" />
          </Button>
        </StackPanel>

        <TextBlock x:Name="SecondaryNote" Visibility="Collapsed" FontSize="18" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,40,0,0"
                   Text="Confirm on your main screen." />
      </StackPanel>

      <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28" FontSize="13" Foreground="#5B6472"
                 Text="Shiftbell · this stays until you confirm" />
    </Grid>

    <!-- Docked: a small always-on-top bar while you go and do it. -->
    <Border x:Name="DockLayout" Visibility="Collapsed" Background="#141820" BorderBrush="{DynamicResource Accent}" BorderThickness="0,3,0,0">
      <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,12">
          <Border CornerRadius="10" Padding="10,3" Background="{DynamicResource Accent}" VerticalAlignment="Center">
            <TextBlock x:Name="DockTag" Text="TIME IN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" />
          </Border>
          <TextBlock x:Name="DockTitle" Text="Timed in? Type “done”" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
          <TextBlock x:Name="DockClock" Text="· back in 3:00" FontSize="14" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBox x:Name="DockConfirmBox" Grid.Row="1" FontSize="15" Height="40" VerticalContentAlignment="Center" Padding="10,0"
                 TextChanged="OnConfirmTextChanged" KeyDown="OnConfirmKeyDown" AutomationProperties.Name="Confirmation phrase" />
        <Button x:Name="DockConfirmButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource BigButton}" Height="40" FontSize="15" Padding="18,0"
                Margin="10,0,0,0" Click="OnConfirm" IsEnabled="False">
          <TextBlock x:Name="DockConfirmLabel" Text="I’ve timed in" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
