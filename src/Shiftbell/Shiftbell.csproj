<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for NotifyIcon and Screen; WPF has neither. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\shiftbell.ico</ApplicationIcon>
    <AssemblyName>Shiftbell</AssemblyName>
    <RootNamespace>Shiftbell</RootNamespace>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- WPF0001: the Fluent ThemeMode API is still marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Publish is one self-contained exe, so the alarm never depends on a separately installed runtime. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both UI stacks define Application, MessageBox, Button...; WPF is the default here. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\shiftbell.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shiftbell.Core\Shiftbell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT. Draws the pairing QR code; nothing else in the app needs it. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
