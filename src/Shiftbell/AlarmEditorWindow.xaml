<Window x:Class="Shiftbell.AlarmEditorWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm"
        ThemeMode="System"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- The app's amber for accent buttons and checked toggles, whatever accent colour Windows uses (grey on some PCs). -->
    <Color x:Key="SystemAccentColor">#F5A623</Color>
    <Color x:Key="SystemAccentColorLight1">#F7B54A</Color>
    <Color x:Key="SystemAccentColorLight2">#F9C670</Color>
    <Color x:Key="SystemAccentColorLight3">#FBD796</Color>
    <Color x:Key="SystemAccentColorDark1">#D9902A</Color>
    <Color x:Key="SystemAccentColorDark2">#B87A23</Color>
    <Color x:Key="SystemAccentColorDark3">#96631C</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F5A623" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E9A033" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D9952F" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#F5A623" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E9A033" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D9952F" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#F5A623" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#E9A033" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#D9952F" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#F5A623" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#E9A033" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D9952F" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#3A3A3A" />
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style x:Key="Day" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Width" Value="40" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="0,5" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,18,24,20">
    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Text="Edit alarm" Margin="0,0,0,16" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="104" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="8" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Style="{StaticResource Label}" Text="Name" />
      <TextBox x:Name="NameBox" Grid.Column="1" />

      <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Time" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
        <TextBox x:Name="TimeBox" Width="110" />
        <TextBlock Style="{StaticResource Label}" Text="Due by" Margin="18,0,10,0" />
        <TextBox x:Name="DeadlineBox" Width="110" ToolTip="Optional. After this the alarm says it is late." />
      </StackPanel>

      <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Repeat" />
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
        <RadioButton x:Name="RepeatDays" Content="On these days" GroupName="Repeat" Checked="OnRepeatChanged" Margin="0,0,18,0" />
        <RadioButton x:Name="RepeatOnce" Content="Once" GroupName="Repeat" Checked="OnRepeatChanged" />
      </StackPanel>

      <StackPanel x:Name="DaysPanel" Grid.Row="6" Grid.Column="1" Orientation="Horizontal" />
      <DatePicker x:Name="OnceDate" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Width="200" Visibility="Collapsed" />

      <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="To stop it" />
      <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
        <RadioButton x:Name="StopTyping" Content="Type &quot;done&quot;" GroupName="Stop" Margin="0,0,18,0" />
        <RadioButton x:Name="StopDismiss" Content="Dismiss button" GroupName="Stop" />
      </StackPanel>

      <TextBlock Grid.Row="10" Style="{StaticResource Label}" Text="Link" />
      <TextBox x:Name="LinkBox" Grid.Row="10" Grid.Column="1" ToolTip="Optional. The alarm's button opens it: your attendance page, a meeting link." />
    </Grid>

    <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

    <Grid Margin="0,20,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button x:Name="DeleteButton" Content="Delete" Click="OnDelete" Foreground="#E5484D" />
        <Button Content="Ring it now" Click="OnTest" Margin="8,0,0,0" ToolTip="Rings this alarm as a test. Nothing is recorded." />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" MinWidth="84" />
        <Button Content="Save" IsDefault="True" Click="OnSave" Style="{StaticResource AccentButtonStyle}" MinWidth="84" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
